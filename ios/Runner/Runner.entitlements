<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Leaderboards (lib/services/placares.dart). -->
	<key>com.apple.developer.game-center</key>
	<true/>
	<!-- Universal Links: a challenge or invite link opens the game when it is
	     installed (web/.well-known/apple-app-site-association); otherwise the
	     link opens the web page. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:capiblocks.vercel.app</string>
	</array>
</dict>
</plist>
