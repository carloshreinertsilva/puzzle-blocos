<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- How the TestFlight workflow (.github/workflows/testflight.yml) exports
     the archive: signed with the run's own distribution certificate and
     "CapiBlocks CI" profile (tool/asc_assinatura.py), and sent straight to
     App Store Connect. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>com.capiblocks.app</key>
		<string>CapiBlocks CI</string>
	</dict>
	<key>teamID</key>
	<string>AJJKP7NQYU</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
