<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Abertura: o fundo do jogo, o Capi e o nome (drawable/launch_background),
         igual com o tema claro ou escuro do celular. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Atrás do jogo enquanto o Flutter desenha: a cor do fundo do jogo. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/capi_fundo</item>
    </style>
</resources>
