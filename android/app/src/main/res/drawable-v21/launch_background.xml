<?xml version="1.0" encoding="utf-8"?>
<!-- Abertura até o Android 11: o fundo do jogo, o Capi no meio e o nome
     embaixo. Do Android 12 em diante vale values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="@color/capi_fundo"
                android:endColor="@color/capi_fundo_baixo" />
        </shape>
    </item>
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_capi" />
    </item>
    <item android:bottom="48dp">
        <bitmap
            android:gravity="bottom|center_horizontal"
            android:src="@drawable/splash_marca" />
    </item>
</layer-list>
