{
  "name": "puzzle-blocos-e2e",
  "private": true,
  "description": "Testes de ponta a ponta do jogo no navegador (Playwright).",
  "scripts": {
    "build": "cd .. && flutter build web --profile --wasm --no-web-resources-cdn --dart-define=TEST_BRIDGE=true -o build/web_test",
    "test": "playwright test",
    "report": "playwright show-report",
    "clipes": "playwright test -c playwright.clipes.config.ts",
    "loja": "playwright test -c playwright.loja.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.2",
    "typescript": "5.6.3"
  }
}
