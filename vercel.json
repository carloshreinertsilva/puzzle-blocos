{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "cleanUrls": true,
  "installCommand": "true",
  "buildCommand": "bash tool/vercel_build.sh",
  "outputDirectory": "build/web",
  "git": {
    "deploymentEnabled": {
      "claude/**": false
    }
  },
  "headers": [
    {
      "source": "/(index.html|flutter_service_worker.js|flutter_bootstrap.js|version.json)?",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/duelo",
      "destination": "/index.html"
    },
    {
      "source": "/convite",
      "destination": "/convite/index.html"
    }
  ]
}
