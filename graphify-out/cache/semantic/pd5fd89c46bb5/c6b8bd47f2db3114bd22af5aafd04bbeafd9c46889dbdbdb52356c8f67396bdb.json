{"nodes": [{"id": "readme_bloco_a_bloco", "label": "Bloco a Bloco (block puzzle game)", "file_type": "document", "source_file": "README.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_game_modes", "label": "Game modes: Fases, Desafio diario, Infinito", "file_type": "concept", "source_file": "README.md", "source_location": "L7", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_praise_effects", "label": "Praise effects (Boa! to Lendario!)", "file_type": "concept", "source_file": "README.md", "source_location": "L14", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_test_bridge", "label": "TEST_BRIDGE web test bridge", "file_type": "concept", "source_file": "README.md", "source_location": "L38", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_vercel_deploy", "label": "Vercel web deployment", "file_type": "concept", "source_file": "README.md", "source_location": "L18", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_solver_always_playable", "label": "Always-playable pieces (Solver check)", "file_type": "rationale", "source_file": "README.md", "source_location": "L64", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Before dealing three pieces the game verifies an order exists where all fit, so losses always come from earlier moves, never an impossible draw."}, {"id": "readme_sawtooth_difficulty", "label": "Sawtooth difficulty curve", "file_type": "rationale", "source_file": "README.md", "source_location": "L67", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Difficulty rises over four levels to a DIFICIL level, followed by a relief level; overall rises slowly."}, {"id": "readme_invisible_adjustment", "label": "Invisible difficulty adjustment", "file_type": "rationale", "source_file": "README.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each consecutive loss on the same level makes the next attempt gentler (smaller pieces, line-completing pieces); a very full board also eases the draw."}, {"id": "readme_deterministic_levels", "label": "Deterministic levels (seeded by level number)", "file_type": "rationale", "source_file": "README.md", "source_location": "L74", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every player gets the same level N, enabling comparison and tuning."}, {"id": "readme_level_simulator", "label": "Level simulator robot (tool/simulate.dart)", "file_type": "concept", "source_file": "README.md", "source_location": "L85", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Used to check the difficulty curve after changing lib/core/level.dart; current calibration ~90% wins on levels 1-15, ~40% on 76-90."}, {"id": "readme_ad_policy", "label": "Ad policy (rewarded + interstitial between levels)", "file_type": "rationale", "source_file": "README.md", "source_location": "L95", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No banner to keep game screen clean; interstitial only after level 6, app open >5 min, last fullscreen ad >6 min ago, with timestamp persisted across restarts."}, {"id": "readme_debug_ad_service", "label": "DebugAdService (placeholder for AdMob)", "file_type": "concept", "source_file": "README.md", "source_location": "L107", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_roadmap", "label": "Roadmap: AdMob, Firebase, remove-ads IAP, Brazil soft launch", "file_type": "concept", "source_file": "README.md", "source_location": "L110", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"